# PostgreSQL connection string. Docker Compose sets this for you.
DATABASE_URL=postgres://spooldeck:spooldeck@localhost:5432/spooldeck

# Connections in the pool (default 10). Set to 1 when using `bun run db:dev` (PGlite),
# which can only serve one connection at a time reliably.
# DATABASE_POOL_MAX=1

# Password for the bundled Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=spooldeck

# Public base URL used inside label QR codes, e.g. https://spools.example.com
# (can also be changed later in Settings). Falls back to the request host.
PUBLIC_URL=
